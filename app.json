{
  "expo": {
    "name": "EmlakÇantam",
    "slug": "emlak-cantam",
    "scheme": "emlakcantam",
    "version": "1.0.0",
    "owner": "canerineci1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canerineci.emlakcantam",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli görüşme notu kaydetmek için mikrofon izni gereklidir."
      }
    },
    "android": {
      "package": "com.canerineci.emlakcantam",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yer gösterme belgesine GPS doğrulama damgası eklemek için konum izni gereklidir."
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "07407118-3eb0-4354-bc27-8079c2273ca5"
      }
    }
  }
}
